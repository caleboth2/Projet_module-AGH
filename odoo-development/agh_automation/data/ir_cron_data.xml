<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tâche : Relances impayés clients -->
        <record id="cron_customer_reminder" model="ir.cron">
            <field name="name">Relances impayés clients</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_customer_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=8)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Alertes échéances fournisseurs -->
        <record id="cron_supplier_alerts" model="ir.cron">
            <field name="name">Alertes échéances fournisseurs</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_supplier_payment_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=7)).strftime('%Y-%m-%d 07:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Clôture mensuelle -->
        <record id="cron_monthly_closing" model="ir.cron">
            <field name="name">Clôture mensuelle automatique</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_monthly_closing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1) + relativedelta(months=1, hour=2, minute=0)).strftime('%Y-%m-%d 02:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Export TVA DGI -->
        <record id="cron_export_tva" model="ir.cron">
            <field name="name">Export TVA DGI</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_export_tva_dgi()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1) + relativedelta(months=1, hour=3, minute=0)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Rappel calendrier fiscal -->
        <record id="cron_fiscal_reminder" model="ir.cron">
            <field name="name">Rappel calendrier fiscal</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_fiscal_calendar_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=9)).strftime('%Y-%m-%d 09:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Sauvegarde DB -->
        <record id="cron_db_backup" model="ir.cron">
            <field name="name">Sauvegarde base de données</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_db_backup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d 01:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Rapport trésorerie -->
        <record id="cron_cash_flow" model="ir.cron">
            <field name="name">Rapport trésorerie</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_cash_flow_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=8)).strftime('%Y-%m-%d 08:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Calcul KPIs -->
        <record id="cron_kpis" model="ir.cron">
            <field name="name">Calcul KPIs</field>
            <field name="model_id" ref="model_agh_scheduled_action"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_kpis()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=23)).strftime('%Y-%m-%d 23:00:00')"/>
            <field name="active">True</field>
        </record>

        <!-- Tâche : Évaluation des règles d’alerte -->
        <record id="cron_evaluate_alerts" model="ir.cron">
            <field name="name">Évaluation des règles d’alerte</field>
            <field name="model_id" ref="model_agh_alert_rule"/>
            <field name="state">code</field>
            <field name="code">model.search([])._evaluate_all_rules()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>