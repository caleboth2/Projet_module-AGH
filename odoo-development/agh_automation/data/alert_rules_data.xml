<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Règle : encours client dépassant plafond (exemple : modèle res.partner avec champ credit_limit) -->
        <record id="alert_rule_credit_limit" model="agh.alert.rule">
            <field name="name">Dépassement plafond de crédit client</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="condition_domain">[('credit_limit', '>', 0), ('total_owed', '>', 'credit_limit')]</field>
            <field name="threshold_value">1</field>
            <field name="alert_type">email</field>
            <field name="recipient_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="active">True</field>
        </record>

        <!-- Règle : solde bancaire inférieur au seuil -->
        <record id="alert_rule_low_balance" model="agh.alert.rule">
            <field name="name">Solde bancaire minimum</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="condition_domain">[('type', '=', 'bank'), ('balance', '&lt;', 10000)]</field>
            <field name="threshold_value">1</field>
            <field name="alert_type">notification</field>
            <field name="recipient_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="active">True</field>
        </record>

        <!-- Règle : facture fournisseur en attente > 5 jours -->
        <record id="alert_rule_bill_pending" model="agh.alert.rule">
            <field name="name">Facture fournisseur en attente >5j</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="condition_domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'draft'), ('create_date', '&lt;=', fields.Date.today())]</field>
            <field name="threshold_value">1</field>
            <field name="alert_type">email</field>
            <field name="recipient_ids" eval="[(4, ref('base.user_root'))]"/>
            <field name="active">True</field>
        </record>
    </data>
</odoo>