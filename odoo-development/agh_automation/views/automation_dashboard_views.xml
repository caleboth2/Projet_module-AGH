<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire Log d'execution -->
    <record id="view_agh_workflow_log_form" model="ir.ui.view">
        <field name="name">agh.workflow.log.form</field>
        <field name="model">agh.workflow.log</field>
        <field name="arch" type="xml">
            <form string="Detail d'execution" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="action_name" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="execution_date" string="Date d'execution"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'failed'"
                                   decoration-warning="status == 'partial' or status == 'warning'"/>
                            <field name="duration" string="Duree (s)"/>
                        </group>
                        <group>
                            <field name="records_processed"
                                   string="Enregistrements traites"/>
                            <field name="errors_count" string="Erreurs"/>
                            <field name="triggered_by" string="Declencheur"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1"/>
                    </group>
                    <group string="Erreurs" invisible="not error_message">
                        <field name="error_message" nolabel="1"
                               widget="text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Liste Journal d'execution -->
    <record id="view_agh_workflow_log_tree" model="ir.ui.view">
        <field name="name">agh.workflow.log.list</field>
        <field name="model">agh.workflow.log</field>
        <field name="arch" type="xml">
            <list string="Journal d'execution" create="false"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'partial' or status == 'warning'">
                <field name="execution_date"/>
                <field name="action_name"/>
                <field name="triggered_by" optional="show"/>
                <field name="records_processed" string="Traites" optional="show"/>
                <field name="duration" string="Duree (s)" optional="show"/>
                <field name="errors_count" string="Erreurs" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'partial' or status == 'warning'"/>
            </list>
        </field>
    </record>

    <!-- Vue Recherche -->
    <record id="view_workflow_log_search" model="ir.ui.view">
        <field name="name">agh.workflow.log.search</field>
        <field name="model">agh.workflow.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="action_name"/>
                <filter name="success" string="Succes"
                        domain="[('status','=','success')]"/>
                <filter name="failed" string="Echoues"
                        domain="[('status','=','failed')]"/>
                <separator/>
                <filter name="this_week" string="Cette semaine"
                        date="execution_date"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_action" string="Action"
                            context="{'group_by': 'action_name'}"/>
                    <filter name="group_status" string="Statut"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard Automatisation (modele transient agh.automation.config) -->
    <record id="view_automation_dashboard" model="ir.ui.view">
        <field name="name">automation.dashboard.form</field>
        <field name="model">agh.automation.config</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord Automatisation"
                  create="false" edit="false">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>
                            <i class="fa fa-cogs me-2 text-primary"/>
                            Automatisation &amp; Alertes
                        </h2>
                    </div>

                    <!-- Stats rapides -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm text-center p-3"
                                 style="border-top: 3px solid #28a745 !important;">
                                <i class="fa fa-check-circle fa-2x text-success mb-2" title="Succès"/>
                                <h5 class="fw-bold text-success mb-0">
                                    <field name="success_count_today" nolabel="1"/>
                                </h5>
                                <small class="text-muted">Succes aujourd'hui</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm text-center p-3"
                                 style="border-top: 3px solid #dc3545 !important;">
                                <i class="fa fa-times-circle fa-2x text-danger mb-2" title="Erreurs"/>
                                <h5 class="fw-bold text-danger mb-0">
                                    <field name="error_count_today" nolabel="1"/>
                                </h5>
                                <small class="text-muted">Erreurs aujourd'hui</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm text-center p-3"
                                 style="border-top: 3px solid #fd7e14 !important;">
                                <i class="fa fa-bell fa-2x text-warning mb-2" title="Alertes"/>
                                <h5 class="fw-bold text-warning mb-0">
                                    <field name="active_alerts_count" nolabel="1"/>
                                </h5>
                                <small class="text-muted">Alertes actives</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card border-0 shadow-sm text-center p-3"
                                 style="border-top: 3px solid #007bff !important;">
                                <i class="fa fa-clock-o fa-2x text-primary mb-2" title="Planifié"/>
                                <h5 class="fw-bold text-primary mb-0">
                                    <field name="scheduled_jobs_count" nolabel="1"/>
                                </h5>
                                <small class="text-muted">Taches planifiees</small>
                            </div>
                        </div>
                    </div>

                    <!-- Dernieres executions -->
                    <group string="Dernieres Executions">
                        <field name="recent_log_ids" nolabel="1">
                            <list create="false"
                                  decoration-success="status == 'success'"
                                  decoration-danger="status == 'failed'">
                                <field name="execution_date"/>
                                <field name="action_name"/>
                                <field name="records_processed"/>
                                <field name="status" widget="badge"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action liste journal -->
    <record id="action_agh_workflow_log" model="ir.actions.act_window">
        <field name="name">Journal des automatisations</field>
        <field name="res_model">agh.workflow.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workflow_log_search"/>
    </record>

    <!-- Menu journal -->
    <menuitem id="menu_agh_workflow_log"
              name="Journal des executions"
              parent="menu_agh_automation_root"
              action="action_agh_workflow_log"
              sequence="20"/>
</odoo>
