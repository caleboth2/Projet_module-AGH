<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         GITHUB CONNECTOR (Sovereign V2)
    ══════════════════════════════════════════════════════════════ -->

    <record id="view_agh_github_connector_form" model="ir.ui.view">
        <field name="name">agh.github.connector.form</field>
        <field name="model">agh.github.connector</field>
        <field name="arch" type="xml">
            <form string="GitHub Connector">
                <header>
                    <button name="action_test_connection" string="Tester la connexion" type="object" class="btn-info"/>
                    <button name="action_import_repos" string="Importer les Dépôts" type="object" class="btn-primary"/>
                    <button name="action_sync_all" string="Synchroniser Tout" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-github">
                            <field name="repository_count" string="Dépôts"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="github_token" password="1"/>
                        </group>
                        <group>
                            <field name="organization_name" placeholder="ex: AppFactoryAgency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dépôts Associés">
                            <field name="repository_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="github_url"/>
                                    <field name="project_id"/>
                                    <field name="commit_count"/>
                                    <field name="issue_count"/>
                                    <field name="last_backup_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agh_github_connector" model="ir.actions.act_window">
        <field name="name">Connecteurs GitHub</field>
        <field name="res_model">agh.github.connector</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         GITHUB REPOSITORY
    ══════════════════════════════════════════════════════════════ -->

    <record id="view_agh_github_repository_form" model="ir.ui.view">
        <field name="name">agh.github.repository.form</field>
        <field name="model">agh.github.repository</field>
        <field name="arch" type="xml">
            <form string="GitHub Repository">
                <header>
                    <button name="action_sync_github" string="🔄 Synchroniser" type="object" class="btn-primary"/>
                    <button name="action_mirror_zip" string="📦 Backup ZIP (Mirror)" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-code-fork">
                            <field name="commit_count" string="Commits"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="issue_count" string="Issues"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-tasks">
                            <field name="pr_count" string="PRs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="github_url"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="connector_id"/>
                            <field name="default_branch"/>
                            <field name="last_backup_date" readonly="1"/>
                            <field name="zip_backup" filename="zip_filename"/>
                            <field name="zip_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commits">
                            <field name="commit_ids">
                                <list>
                                    <field name="sha"/>
                                    <field name="name"/>
                                    <field name="author"/>
                                    <field name="date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Issues">
                            <field name="issue_ids">
                                <list>
                                    <field name="number"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'open'" decoration-info="state == 'closed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pull Requests">
                            <field name="pull_request_ids">
                                <list>
                                    <field name="number"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge" decoration-success="state == 'open'" decoration-primary="state == 'merged'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         GITHUB ISSUE (Avec commentaires)
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_agh_github_issue_form" model="ir.ui.view">
        <field name="name">agh.github.issue.form</field>
        <field name="model">agh.github.issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <field name="number"/>
                        <field name="state"/>
                    </group>
                    <separator string="Description"/>
                    <field name="body"/>
                    <separator string="Historique des discussions (Mirroring)"/>
                    <field name="comment_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="author" string="Utilisateur"/>
                            <field name="body"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agh_github_repository" model="ir.actions.act_window">
        <field name="name">Dépôts (Mirroring)</field>
        <field name="res_model">agh.github.repository</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         MENUS
    ══════════════════════════════════════════════════════════════ -->
    <menuitem id="menu_github_integration_root" name="GitHub Sovereign" sequence="85"/>
    <menuitem id="menu_github_connector" name="Connecteurs" parent="menu_github_integration_root" action="action_agh_github_connector" sequence="10"/>
    <menuitem id="menu_github_repositories" name="Mirroring &amp; Backup" parent="menu_github_integration_root" action="action_agh_github_repository" sequence="20"/>

</odoo>
