<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Catégorie ── -->
        <record id="module_category_performance" model="ir.module.category">
            <field name="name">AGH Performance Tracker</field>
            <field name="description">Gestion des évaluations de performance</field>
            <field name="sequence">100</field>
        </record>

        <!-- ── Groupes ── -->
        <record id="group_performance_user" model="res.groups">
            <field name="name">Utilisateur (lecture seule)</field>
            <field name="category_id" ref="module_category_performance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_performance_evaluator" model="res.groups">
            <field name="name">Évaluateur (Manager)</field>
            <field name="category_id" ref="module_category_performance"/>
            <field name="implied_ids" eval="[(4, ref('group_performance_user'))]"/>
        </record>

        <record id="group_performance_manager" model="res.groups">
            <field name="name">Responsable RH / Admin</field>
            <field name="category_id" ref="module_category_performance"/>
            <field name="implied_ids" eval="[(4, ref('group_performance_evaluator'))]"/>
        </record>

    </data>
</odoo>
