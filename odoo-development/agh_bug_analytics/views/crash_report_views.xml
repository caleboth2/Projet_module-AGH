<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agh_crash_report_tree"
            model="ir.ui.view">

        <field name="name">agh.crash.report.tree</field>

        <field name="model">agh.crash.report</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>

                <field name="title"/>

                <field name="severity"/>

                <field name="state"/>

                <field name="occurrence_count"/>

            </list>

        </field>

    </record>


    <record id="view_agh_crash_report_form"
            model="ir.ui.view">

        <field name="name">agh.crash.report.form</field>

        <field name="model">agh.crash.report</field>

        <field name="arch" type="xml">

            <form string="Crash Report">
                <header>

                    <button
                        name="action_create_ticket"
                        type="object"
                        string="Create Technical Ticket"
                        class="btn-primary"
                        invisible="task_id != False"/>
                
                    <field
                        name="state"
                        widget="statusbar"/>
                
                </header>

                <sheet>

                    <group>

                        <field name="name" readonly="1"/>

                        <field name="title"/>

                        <field name="signature"/>

                        <field name="source"/>

                        <field name="severity"/>

                        <field name="state"/>

                        <field name="occurrence_count" readonly="1"/>

                        <field name="task_id" readonly="1"/>

                    </group>

                    <group>

                        <field name="description"/>

                    </group>

                </sheet>
            <chatter/>

            </form>

        </field>

    </record>


    <record id="action_agh_crash_report"
            model="ir.actions.act_window">

        <field name="name">Crash Analytics</field>

        <field name="res_model">agh.crash.report</field>

        <field name="view_mode">list,form</field>

    </record>

    <record id="action_agh_crash_report"
        model="ir.actions.act_window">

        <field name="name">Crash Analytics</field>
    
        <field name="res_model">agh.crash.report</field>
    
        <field name="view_mode">list,form</field>
    
    </record>
    
    
    <menuitem
        id="menu_agh_crash_report"
        name="Crash Analytics"
        parent="project.menu_main_pm"
        action="action_agh_crash_report"
        sequence="99"/>

</odoo>