<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_apk" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'licenses'" class="breadcrumb-item active">Licences APK</li>
        </xpath>
    </template>

    <template id="portal_my_home_apk" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]/div[hasclass('row')][1]" position="inside">
            <div class="o_portal_category col-12 col-md-6 col-lg-4">
                <a href="/my/licenses" class="d-flex align-items-center py-3 px-2 rounded text-decoration-none">
                    <i class="fa fa-mobile fa-2x me-3"/>
                    <span>Mes licences APK</span>
                </a>
            </div>
        </xpath>
    </template>

    <template id="portal_my_licenses" name="Mes licences APK">
        <t t-call="portal.portal_layout">
            <t t-set="title">Mes licences APK</t>
            <div class="container o_portal_wrap">
                <h3 class="mb-4">Mes licences APK</h3>
                <t t-if="licenses">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Clé de licence</th>
                                    <th>État</th>
                                    <th>Validité</th>
                                    <th class="text-end">Téléchargement</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="licenses" t-as="license">
                                    <td><span t-field="license.product_id.name"/></td>
                                    <td>
                                        <code t-att-id="'license-' + str(license.id)"><t t-esc="license.name"/></code>
                                        <button type="button" class="o_apk_copy_license btn btn-sm btn-outline-secondary ms-2" t-att-data-copy-target="'license-' + str(license.id)" title="Copier la clé">
                                            <i class="fa fa-copy"/>
                                        </button>
                                    </td>
                                    <td><span t-field="license.state"/></td>
                                    <td><span t-if="license.valid_until" t-field="license.valid_until"/><span t-else="">Sans expiration</span></td>
                                    <td class="text-end">
                                        <a t-if="license.state == 'active'" t-att-href="'/shop/apk/download/' + license.download_token" class="btn btn-primary btn-sm">Télécharger</a>
                                        <span t-else="" class="text-muted">Indisponible</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
                <p t-else="" class="alert alert-info">Aucune licence APK n'est associée à votre compte.</p>
            </div>
        </t>
    </template>
</odoo>