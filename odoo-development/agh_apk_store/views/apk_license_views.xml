<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_apk_license" model="ir.actions.act_window">
        <field name="name">Licences Générées</field>
        <field name="res_model">agh.apk.license</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_agh_apk_license_list" model="ir.ui.view">
        <field name="name">agh.apk.license.list</field>
        <field name="model">agh.apk.license</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <field name="valid_until"/>
                <field name="max_activations"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_agh_apk_license_form" model="ir.ui.view">
        <field name="name">agh.apk.license.form</field>
        <field name="model">agh.apk.license</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                        <field name="partner_id"/>
                        <field name="product_id"/>
                        <field name="sale_order_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="valid_until"/>
                        <field name="max_activations"/>
                        <field name="device_ids"/>
                        <field name="download_token" groups="base.group_system"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agh_apk_license_search" model="ir.ui.view">
        <field name="name">agh.apk.license.search</field>
        <field name="model">agh.apk.license</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="state"/>
                <filter name="active" string="Actives" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expirées" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Société" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_apk_license_root" name="Boutique APK" parent="sale.sale_menu_root" sequence="90"/>
    <menuitem id="menu_apk_license_list" name="Licences" parent="menu_apk_license_root" action="action_apk_license"/>
</odoo>