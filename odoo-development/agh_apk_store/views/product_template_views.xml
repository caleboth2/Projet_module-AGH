<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_apk" model="ir.ui.view">
        <field name="name">product.template.form.inherit.apk</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="is_apk" widget="boolean_toggle"/>
                <field name="apk_version" invisible="not is_apk" placeholder="Ex: v1.2.4"/>
                <field name="apk_file" filename="apk_filename" invisible="not is_apk"/>
                <field name="apk_filename" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>