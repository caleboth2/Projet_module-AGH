<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contract_form_custom_attestation"
            model="ir.ui.view">

        <field name="name">hr.contract.form.custom.attestation</field>

        <field name="model">hr.contract</field>

        <field name="inherit_id"
               ref="hr_contract.hr_contract_view_form"/>

        <field name="arch"
               type="xml">

            <xpath expr="//header"
                   position="inside">

                <button
                    name="action_print_custom_attestation"
                    type="object"
                    string="Print Attestation"
                    class="btn-primary"/>

            </xpath>

            <field name="date_start"
                   position="after">

                <field name="reference_period_months"/>

                <field name="reference_period_end_date"
                       readonly="1"/>

                <field name="is_reference_period_active"
                       readonly="1"/>

            </field>

        </field>

    </record>

</odoo>