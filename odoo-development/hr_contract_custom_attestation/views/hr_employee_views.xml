<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_custom_attestation"
            model="ir.ui.view">
        <field name="name">
            hr.employee.form.custom.attestation
        </field>
        <field name="model">
            hr.employee
        </field>
        <field name="inherit_id"
                ref="hr.view_employee_form"/>
        <field name="arch"
               type="xml">

            <xpath expr="//sheet/group"
                   position="inside">

                <field name="reference_period_months"/>

            </xpath>

        </field>
    </record>

</odoo>