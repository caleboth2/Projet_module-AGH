<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_ras_declaration_form" model="ir.ui.view">
        <field name="name">wizard.ras.declaration.form</field>
        <field name="model">wizard.ras.declaration</field>
        <field name="arch" type="xml">
            <form string="Declaration mensuelle Retenue a la Source (RAS)">
                <group>
                    <group string="Periode">
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_declaration" string="Generer la declaration" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_ras_declaration" model="ir.actions.act_window">
        <field name="name">Declaration RAS</field>
        <field name="res_model">wizard.ras.declaration</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
