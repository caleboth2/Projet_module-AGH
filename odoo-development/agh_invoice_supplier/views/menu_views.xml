<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         ACTIONS — Gestion complète des fournisseurs
    ============================================================ -->

    <!-- Action : Liste des fournisseurs (filtrée) -->
    <record id="action_partner_supplier_maroc" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supplier_rank','>',0)]</field>
        <field name="context">{
            'search_default_supplier': 1,
            'res_partner_search_mode': 'supplier',
            'default_is_company': True,
            'default_supplier_rank': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un fournisseur
            </p>
            <p>
                Gérez l'ensemble de vos fournisseurs : ICE, IF, RC, CNSS,
                soumission à la retenue à la source (RAS), conditions de paiement.
            </p>
        </field>
    </record>

    <!-- Action : Avoirs fournisseurs -->
    <record id="action_supplier_refunds" model="ir.actions.act_window">
        <field name="name">Avoirs Fournisseurs</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('move_type','=','in_refund')]</field>
        <field name="context">{
            'default_move_type': 'in_refund',
            'journal_type': 'purchase'
        }</field>
    </record>

    <!-- Action : Paiements fournisseurs -->
    <record id="action_supplier_payments" model="ir.actions.act_window">
        <field name="name">Paiements Fournisseurs</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('partner_type','=','supplier')]</field>
        <field name="context">{
            'default_partner_type': 'supplier',
            'default_payment_type': 'outbound'
        }</field>
    </record>

    <!-- ============================================================
         MENU PRINCIPAL — Fournisseurs
         (anciennement « Fournisseurs AGH » — renommé en « Fournisseurs »
          pour une gestion fournisseur complète et claire)
    ============================================================ -->

    <menuitem id="menu_agh_invoice_supplier_root"
              name="Fournisseurs"
              sequence="20"
              web_icon="purchase,static/description/icon.png"
              groups="account.group_account_invoice,purchase.group_purchase_user"/>

    <!-- ===== Section : Tableau de bord ===== -->
    <menuitem id="menu_supplier_dashboard"
              name="Tableau de bord"
              parent="menu_agh_invoice_supplier_root"
              action="purchase.purchase_form_action"
              sequence="5"/>

    <!-- ===== Section : Fournisseurs (partenaires) ===== -->
    <menuitem id="menu_supplier_partners_root"
              name="Fournisseurs"
              parent="menu_agh_invoice_supplier_root"
              sequence="10"/>

    <menuitem id="menu_supplier_partners_list"
              name="Liste des fournisseurs"
              parent="menu_supplier_partners_root"
              action="action_partner_supplier_maroc"
              sequence="10"/>

    <menuitem id="menu_supplier_products"
              name="Produits / Articles fournisseurs"
              parent="menu_supplier_partners_root"
              action="product.product_template_action"
              sequence="20"/>

    <!-- ===== Section : Achats (RFQ, BC, BR) ===== -->
    <menuitem id="menu_supplier_purchase_root"
              name="Achats"
              parent="menu_agh_invoice_supplier_root"
              sequence="20"/>

    <menuitem id="menu_supplier_rfq"
              name="Demandes de prix"
              parent="menu_supplier_purchase_root"
              action="purchase.purchase_rfq"
              sequence="10"/>

    <menuitem id="menu_supplier_purchase_orders"
              name="Bons de commande"
              parent="menu_supplier_purchase_root"
              action="purchase.purchase_form_action"
              sequence="20"/>

    <menuitem id="menu_supplier_receipts"
              name="Réceptions (Bons de réception)"
              parent="menu_supplier_purchase_root"
              action="stock.action_picking_tree_all"
              sequence="30"
              groups="stock.group_stock_user"/>

    <!-- ===== Section : Factures & Paiements ===== -->
    <menuitem id="menu_supplier_billing_root"
              name="Factures &amp; Paiements"
              parent="menu_agh_invoice_supplier_root"
              sequence="30"/>

    <menuitem id="menu_agh_supplier_invoices"
              name="Factures Fournisseurs"
              parent="menu_supplier_billing_root"
              action="account.action_move_in_invoice_type"
              sequence="10"/>

    <menuitem id="menu_agh_supplier_refunds"
              name="Avoirs Fournisseurs"
              parent="menu_supplier_billing_root"
              action="action_supplier_refunds"
              sequence="20"/>

    <menuitem id="menu_agh_supplier_payments"
              name="Paiements Fournisseurs"
              parent="menu_supplier_billing_root"
              action="action_supplier_payments"
              sequence="30"/>

    <menuitem id="menu_agh_3way_match"
              name="Rapprochement 3 voies"
              parent="menu_supplier_billing_root"
              action="action_wizard_3way_match"
              sequence="40"/>

    <!-- ===== Section : Retenue à la Source (RAS) ===== -->
    <menuitem id="menu_agh_ras_main"
              name="Retenue à la Source"
              parent="menu_agh_invoice_supplier_root"
              sequence="40"/>

    <menuitem id="menu_agh_ras_lines"
              name="Retenues à la source"
              parent="menu_agh_ras_main"
              action="action_account_ras_maroc"
              sequence="10"/>

    <menuitem id="menu_agh_ras_declarations"
              name="Déclarations mensuelles"
              parent="menu_agh_ras_main"
              action="action_account_ras_declaration"
              sequence="20"/>

    <menuitem id="menu_agh_ras_declaration_wizard"
              name="Générer une déclaration"
              parent="menu_agh_ras_main"
              action="action_wizard_ras_declaration"
              sequence="30"/>

</odoo>
