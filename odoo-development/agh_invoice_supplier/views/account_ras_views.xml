<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ras_maroc_tree" model="ir.ui.view">
        <field name="name">account.ras.maroc.list</field>
        <field name="model">account.ras.maroc</field>
        <field name="arch" type="xml">
            <list string="Retenues a la source">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="ras_type"/>
                <field name="ras_rate"/>
                <field name="taxable_base"/>
                <field name="ras_amount" sum="Total"/>
                <field name="date"/>
                <field name="declaration_id"/>
                <field name="certificate_issued" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ras_maroc_form" model="ir.ui.view">
        <field name="name">account.ras.maroc.form</field>
        <field name="model">account.ras.maroc</field>
        <field name="arch" type="xml">
            <form string="Retenue a la source">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="ras_type"/>
                            <field name="ras_rate"/>
                        </group>
                        <group>
                            <field name="taxable_base"/>
                            <field name="ras_amount"/>
                            <field name="date" readonly="1"/>
                            <field name="period" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Declaration">
                        <field name="declaration_id"/>
                        <field name="certificate_issued"/>
                        <field name="certificate_number"/>
                        <field name="ras_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_ras_maroc" model="ir.actions.act_window">
        <field name="name">Retenues a la source</field>
        <field name="res_model">account.ras.maroc</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ras_declaration_tree" model="ir.ui.view">
        <field name="name">account.ras.declaration.list</field>
        <field name="model">account.ras.declaration</field>
        <field name="arch" type="xml">
            <list string="Declarations RAS">
                <field name="name"/>
                <field name="month"/>
                <field name="year"/>
                <field name="declaration_date"/>
                <field name="total_taxable_base" sum="Total"/>
                <field name="total_ras_amount" sum="Total"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-warning="status == 'submitted'"
                       decoration-success="status == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_ras_declaration_form" model="ir.ui.view">
        <field name="name">account.ras.declaration.form</field>
        <field name="model">account.ras.declaration</field>
        <field name="arch" type="xml">
            <form string="Declaration RAS">
                <header>
                    <button name="action_submit" type="object" string="Soumettre"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_set_paid" type="object" string="Marquer comme payee"
                            class="btn-primary" invisible="status != 'submitted'"/>
                    <button name="action_generate_file" type="object"
                            string="Generer fichier DGI" class="btn-secondary"
                            invisible="status == 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            class="btn-secondary" invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,submitted,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="month"/>
                            <field name="year"/>
                            <field name="declaration_date"/>
                        </group>
                        <group>
                            <field name="total_taxable_base"/>
                            <field name="total_ras_amount"/>
                            <field name="company_id"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="ras_ids">
                        <list>
                            <field name="partner_id"/>
                            <field name="invoice_id"/>
                            <field name="ras_type"/>
                            <field name="ras_rate"/>
                            <field name="taxable_base"/>
                            <field name="ras_amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_ras_declaration" model="ir.actions.act_window">
        <field name="name">Declarations RAS</field>
        <field name="res_model">account.ras.declaration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
