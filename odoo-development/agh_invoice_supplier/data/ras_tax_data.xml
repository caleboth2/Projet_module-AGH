<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ras_certificate" model="ir.sequence">
            <field name="name">Attestation RAS</field>
            <field name="code">ras.certificate</field>
            <field name="prefix">RAS-CERT-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
