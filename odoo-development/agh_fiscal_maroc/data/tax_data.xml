<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             GROUPES DE TVA MAROCAINS
             (champ tax_group_id obligatoire sur account.tax depuis Odoo 18)
        ============================================================ -->

        <record id="tax_group_tva_collecte" model="account.tax.group">
            <field name="name">TVA Collectée (Maroc)</field>
            <field name="sequence">10</field>
        </record>

        <record id="tax_group_tva_deductible" model="account.tax.group">
            <field name="name">TVA Déductible (Maroc)</field>
            <field name="sequence">20</field>
        </record>

        <record id="tax_group_tva_exoneree" model="account.tax.group">
            <field name="name">TVA Exonérée (Maroc)</field>
            <field name="sequence">30</field>
        </record>

        <!-- ============================================================
             TAXES TVA MAROCAINES — Collectées (ventes)
        ============================================================ -->

        <record id="tax_tva_collecte_20" model="account.tax">
            <field name="name">TVA Collectée 20%</field>
            <field name="amount">20.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_tva_collecte"/>
            <field name="moroccan_tva_rate">20</field>
            <field name="is_tva_collecte" eval="True"/>
            <field name="tva_type">collecte</field>
        </record>

        <record id="tax_tva_collecte_14" model="account.tax">
            <field name="name">TVA Collectée 14%</field>
            <field name="amount">14.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_tva_collecte"/>
            <field name="moroccan_tva_rate">14</field>
            <field name="is_tva_collecte" eval="True"/>
            <field name="tva_type">collecte</field>
        </record>

        <record id="tax_tva_collecte_10" model="account.tax">
            <field name="name">TVA Collectée 10%</field>
            <field name="amount">10.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_tva_collecte"/>
            <field name="moroccan_tva_rate">10</field>
            <field name="is_tva_collecte" eval="True"/>
            <field name="tva_type">collecte</field>
        </record>

        <record id="tax_tva_collecte_7" model="account.tax">
            <field name="name">TVA Collectée 7%</field>
            <field name="amount">7.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_tva_collecte"/>
            <field name="moroccan_tva_rate">7</field>
            <field name="is_tva_collecte" eval="True"/>
            <field name="tva_type">collecte</field>
        </record>

        <record id="tax_tva_exonere_sale" model="account.tax">
            <field name="name">TVA Exonérée (Ventes)</field>
            <field name="amount">0.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_tva_exoneree"/>
            <field name="moroccan_tva_rate">0</field>
            <field name="tva_type">collecte</field>
        </record>

        <!-- ============================================================
             TAXES TVA MAROCAINES — Déductibles (achats)
        ============================================================ -->

        <record id="tax_tva_deductible_20" model="account.tax">
            <field name="name">TVA Déductible 20%</field>
            <field name="amount">20.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="tax_group_tva_deductible"/>
            <field name="moroccan_tva_rate">20</field>
            <field name="is_tva_deductible" eval="True"/>
            <field name="tva_type">deductible</field>
        </record>

        <record id="tax_tva_deductible_14" model="account.tax">
            <field name="name">TVA Déductible 14%</field>
            <field name="amount">14.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="tax_group_tva_deductible"/>
            <field name="moroccan_tva_rate">14</field>
            <field name="is_tva_deductible" eval="True"/>
            <field name="tva_type">deductible</field>
        </record>

        <record id="tax_tva_deductible_10" model="account.tax">
            <field name="name">TVA Déductible 10%</field>
            <field name="amount">10.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="tax_group_tva_deductible"/>
            <field name="moroccan_tva_rate">10</field>
            <field name="is_tva_deductible" eval="True"/>
            <field name="tva_type">deductible</field>
        </record>

        <record id="tax_tva_deductible_7" model="account.tax">
            <field name="name">TVA Déductible 7%</field>
            <field name="amount">7.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="tax_group_tva_deductible"/>
            <field name="moroccan_tva_rate">7</field>
            <field name="is_tva_deductible" eval="True"/>
            <field name="tva_type">deductible</field>
        </record>

        <record id="tax_tva_exonere_purchase" model="account.tax">
            <field name="name">TVA Exonérée (Achats)</field>
            <field name="amount">0.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="tax_group_tva_exoneree"/>
            <field name="moroccan_tva_rate">0</field>
            <field name="tva_type">deductible</field>
        </record>

    </data>
</odoo>
