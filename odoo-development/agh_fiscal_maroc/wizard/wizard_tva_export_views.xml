<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wizard_tva_export_form" model="ir.ui.view">
        <field name="name">wizard.tva.export.form</field>
        <field name="model">wizard.tva.export</field>
        <field name="arch" type="xml">
            <form string="Export déclaration TVA pour la DGI">
                <group>
                    <field name="declaration_id"/>
                    <field name="export_format"/>
                    <field name="include_lines"/>
                </group>
                <group invisible="not file_data">
                    <field name="filename"/>
                    <field name="file_data" filename="filename"/>
                </group>
                <footer>
                    <button name="action_export" string="Exporter"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_tva_export" model="ir.actions.act_window">
        <field name="name">Export TVA pour la DGI</field>
        <field name="res_model">wizard.tva.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_tva_declaration"/>
        <field name="binding_view_types">form,list</field>
    </record>

</odoo>
