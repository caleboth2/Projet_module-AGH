<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_is_declaration_list" model="ir.ui.view">
        <field name="name">account.is.declaration.list</field>
        <field name="model">account.is.declaration</field>
        <field name="arch" type="xml">
            <list string="Déclarations IS"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'calculated'"
                  decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="company_id"/>
                <field name="fiscal_year"/>
                <field name="fiscal_result" sum="Total Résultat"/>
                <field name="is_amount" sum="Total IS"/>
                <field name="solde_is" sum="Total Solde"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_account_is_declaration_form" model="ir.ui.view">
        <field name="name">account.is.declaration.form</field>
        <field name="model">account.is.declaration</field>
        <field name="arch" type="xml">
            <form string="Déclaration IS">
                <header>
                    <button name="action_calculate_from_accounts"
                            string="Calculer"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirmer"
                            type="object" class="btn-primary"
                            invisible="state != 'calculated'"/>
                    <button name="action_generate_liasse"
                            string="Générer la liasse"
                            type="object"
                            invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_submit_dgi"
                            string="Soumettre à la DGI"
                            type="object" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_pay" string="Marquer payée"
                            type="object" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_open_acompte_wizard"
                            string="Saisir un acompte"
                            type="object"
                            invisible="state in ('draft', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,confirmed,submitted,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="fiscal_year"/>
                            <field name="company_type"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Résultat fiscal" name="result">
                            <group>
                                <group string="Calcul">
                                    <field name="accounting_result"/>
                                    <field name="fiscal_reintegration"/>
                                    <field name="fiscal_deduction"/>
                                    <field name="fiscal_result" class="oe_subtotal_footer_separator"/>
                                </group>
                                <group string="Impôt sur les sociétés">
                                    <field name="is_rate"/>
                                    <field name="is_amount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cotisation Minimale" name="cm">
                            <group>
                                <group>
                                    <field name="cm_base"/>
                                    <field name="cm_rate"/>
                                    <field name="cm_amount"/>
                                </group>
                                <group>
                                    <field name="is_higher_than_cm"/>
                                    <field name="amount_to_pay" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page string="Acomptes provisionnels" name="acomptes">
                            <group>
                                <group string="Acomptes versés">
                                    <field name="acompte_t1"/>
                                    <field name="acompte_t2"/>
                                    <field name="acompte_t3"/>
                                    <field name="acompte_t4"/>
                                    <field name="total_acomptes" class="oe_subtotal_footer_separator"/>
                                </group>
                                <group string="Solde">
                                    <field name="solde_is"/>
                                    <field name="credit_is"/>
                                    <field name="penalties"/>
                                    <field name="total_a_payer" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                            <field name="acompte_lines">
                                <list editable="bottom">
                                    <field name="trimester"/>
                                    <field name="amount"/>
                                    <field name="payment_date"/>
                                    <field name="payment_ref"/>
                                    <field name="is_paid"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents &amp; soumission" name="docs">
                            <group>
                                <group>
                                    <field name="liasse_filename"/>
                                    <field name="liasse_fiscale" filename="liasse_filename"/>
                                </group>
                                <group>
                                    <field name="submitted_date"/>
                                    <field name="payment_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_is_declaration_search" model="ir.ui.view">
        <field name="name">account.is.declaration.search</field>
        <field name="model">account.is.declaration</field>
        <field name="arch" type="xml">
            <search string="Recherche déclaration IS">
                <field name="name"/>
                <field name="company_id"/>
                <field name="fiscal_year"/>
                <filter string="Brouillon" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmée" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Payée" name="filter_paid" domain="[('state','=','paid')]"/>
                <group expand="1" string="Grouper par">
                    <filter string="Société" name="group_company" context="{'group_by':'company_id'}"/>
                    <filter string="Exercice" name="group_year" context="{'group_by':'fiscal_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_is_declaration" model="ir.actions.act_window">
        <field name="name">Déclarations IS</field>
        <field name="res_model">account.is.declaration</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
