<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_view_form_inherit_agh" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.agh</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="agh_job_template_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
