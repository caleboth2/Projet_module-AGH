<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_view_form_inherit_agh" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.agh</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Trame de l'étape" invisible="not agh_stage_structure">
                        <field name="agh_stage_structure" widget="html" readonly="1"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
