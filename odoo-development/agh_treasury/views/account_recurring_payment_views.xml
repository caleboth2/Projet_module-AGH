<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recurring_payment_tree" model="ir.ui.view">
        <field name="name">account.recurring.payment.list</field>
        <field name="model">account.recurring.payment</field>
        <field name="arch" type="xml">
            <list string="Paiements recurrents">
                <field name="name"/>
                <field name="type"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="frequency"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_recurring_payment_form" model="ir.ui.view">
        <field name="name">account.recurring.payment.form</field>
        <field name="model">account.recurring.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement recurrent">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="frequency"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recurring_payment" model="ir.actions.act_window">
        <field name="name">Paiements recurrents</field>
        <field name="res_model">account.recurring.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
