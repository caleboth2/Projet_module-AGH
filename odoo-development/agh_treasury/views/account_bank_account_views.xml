<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_account_tree" model="ir.ui.view">
        <field name="name">account.bank.account.list</field>
        <field name="model">account.bank.account</field>
        <field name="arch" type="xml">
            <list string="Comptes bancaires">
                <field name="name"/>
                <field name="bank_name"/>
                <field name="iban"/>
                <field name="rib"/>
                <field name="currency_id"/>
                <field name="current_balance" widget="monetary"/>
                <field name="last_statement_date"/>
                <field name="has_alert" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bank_account_form" model="ir.ui.view">
        <field name="name">account.bank.account.form</field>
        <field name="model">account.bank.account</field>
        <field name="arch" type="xml">
            <form string="Compte bancaire">
                <header>
                    <button name="action_view_statements" type="object" string="Voir les releves" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations bancaires">
                            <field name="bank_name"/>
                            <field name="iban"/>
                            <field name="bic"/>
                            <field name="rib"/>
                            <field name="journal_id"/>
                        </group>
                        <group string="Solde">
                            <field name="currency_id"/>
                            <field name="current_balance"/>
                            <field name="minimum_balance"/>
                            <field name="last_statement_date"/>
                            <field name="has_alert"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_account_kanban" model="ir.ui.view">
        <field name="name">account.bank.account.kanban</field>
        <field name="model">account.bank.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false">
                <field name="name"/>
                <field name="bank_name"/>
                <field name="current_balance"/>
                <field name="currency_id"/>
                <field name="iban"/>
                <field name="last_statement_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex align-items-center p-2">
                                <div class="flex-grow-1">
                                    <strong class="d-block"><field name="name"/></strong>
                                    <span class="text-muted small"><field name="bank_name"/></span>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success fs-5">
                                        <field name="current_balance" widget="monetary"/>
                                    </div>
                                    <small class="text-muted"><field name="currency_id"/></small>
                                </div>
                            </div>
                            <div class="px-2 pb-2 border-top mt-1 pt-1">
                                <small class="text-muted">
                                    Dernier releve: <field name="last_statement_date"/>
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_bank_account" model="ir.actions.act_window">
        <field name="name">Comptes bancaires</field>
        <field name="res_model">account.bank.account</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
