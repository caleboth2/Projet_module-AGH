<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_bank_reconcile_form" model="ir.ui.view">
        <field name="name">wizard.bank.reconcile.form</field>
        <field name="model">wizard.bank.reconcile</field>
        <field name="arch" type="xml">
            <form string="Rapprochement Bancaire Automatique">
                <group>
                    <group string="Releve bancaire">
                        <field name="statement_id"/>
                        <field name="match_threshold"/>
                        <field name="days_lookback"/>
                        <field name="include_old_transactions"/>
                    </group>
                </group>
                <group string="Resume" invisible="not result_summary">
                    <field name="result_summary" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_reconcile" string="Lancer le rapprochement" type="object" class="btn-primary"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_bank_reconcile" model="ir.actions.act_window">
        <field name="name">Rapprochement Bancaire</field>
        <field name="res_model">wizard.bank.reconcile</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
