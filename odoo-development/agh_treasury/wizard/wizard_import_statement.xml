<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_import_statement_form" model="ir.ui.view">
        <field name="name">wizard.import.statement.form</field>
        <field name="model">wizard.import.statement</field>
        <field name="arch" type="xml">
            <form string="Import Releve Bancaire">
                <group>
                    <group string="Fichier">
                        <field name="format"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="statement_id"/>
                    </group>
                    <group string="Options CSV" invisible="format != 'csv'">
                        <field name="csv_delimiter"/>
                        <field name="csv_date_format"/>
                        <field name="csv_columns_mapping"/>
                    </group>
                </group>
                <footer>
                    <button name="action_import" string="Importer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_import_statement" model="ir.actions.act_window">
        <field name="name">Import Releve Bancaire</field>
        <field name="res_model">wizard.import.statement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
