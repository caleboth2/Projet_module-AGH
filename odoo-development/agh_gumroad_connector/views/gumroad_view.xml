<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_agh_gumroad_connector_form" model="ir.ui.view">
        <field name="name">agh.gumroad.connector.form</field>
        <field name="model">agh.gumroad.connector</field>
        <field name="arch" type="xml">
            <form string="AGH Gumroad Connector">
                <header>
                    <button name="action_test_connection" string="Tester la Connexion"
                            type="object" class="btn-primary" icon="fa-plug"/>
                    <button name="action_disconnect" string="Déconnecter"
                            type="object" class="btn-secondary" icon="fa-times"
                            invisible="status != 'connected'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="disconnected,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom du connecteur..."/></h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="access_token" password="True"
                                   placeholder="Collez ici votre Access Token Gumroad"/>
                        </group>
                        <group string="Informations Gumroad">
                            <field name="gumroad_user_name" readonly="1"/>
                            <field name="gumroad_user_email" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="status != 'disconnected'">
                        <strong>Comment obtenir votre Access Token :</strong><br/>
                        Allez sur <strong>app.gumroad.com</strong> → Settings → Advanced →
                        copiez votre Access Token.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="status != 'connected'">
                        ✅ Connexion active avec Gumroad.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="status != 'error'">
                        ❌ Erreur de connexion. Vérifiez votre Access Token.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agh_gumroad_connector_list" model="ir.ui.view">
        <field name="name">agh.gumroad.connector.list</field>
        <field name="model">agh.gumroad.connector</field>
        <field name="arch" type="xml">
            <list string="AGH Gumroad Connectors" decoration-success="status == 'connected'"
                  decoration-danger="status == 'error'" decoration-muted="status == 'disconnected'">
                <field name="name"/>
                <field name="gumroad_user_email"/>
                <field name="last_sync"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'connected'"
                       decoration-danger="status == 'error'"
                       decoration-warning="status == 'disconnected'"/>
            </list>
        </field>
    </record>

    <record id="view_agh_gumroad_connector_search" model="ir.ui.view">
        <field name="name">agh.gumroad.connector.search</field>
        <field name="model">agh.gumroad.connector</field>
        <field name="arch" type="xml">
            <search string="Rechercher un connecteur">
                <field name="name"/>
                <field name="gumroad_user_email"/>
                <filter string="Connecté" name="connected" domain="[('status', '=', 'connected')]"/>
                <filter string="Erreur" name="error" domain="[('status', '=', 'error')]"/>
                <filter string="Déconnecté" name="disconnected" domain="[('status', '=', 'disconnected')]"/>
            </search>
        </field>
    </record>

    <record id="action_agh_gumroad_connector" model="ir.actions.act_window">
        <field name="name">AGH Gumroad Connectors</field>
        <field name="res_model">agh.gumroad.connector</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_agh_gumroad_connector_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier connecteur Gumroad !</p>
        </field>
    </record>

    <menuitem id="menu_agh_gumroad_root" name="AGH Gumroad" sequence="91"
              web_icon="gumroad_connector,static/description/icon.png"/>
    <menuitem id="menu_agh_gumroad_connector" name="Connecteurs"
              parent="menu_agh_gumroad_root"
              action="action_agh_gumroad_connector" sequence="1"/>

</odoo>
