<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_attestation" model="ir.ui.view">
        <field name="name">hr.employee.form.attestation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">1</field>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_open_knowledge_articles"
                        type="object"
                        string="📁 Dossier RH"
                        class="btn-secondary"/>
                <button name="action_download_attestation"
                        type="object"
                        string="Télécharger Attestation"
                        class="btn-primary"/>
            </xpath>

            <xpath expr="//sheet/notebook" position="before">
                <group string="Attestation Automatique">
                    <field name="is_intern"/>
                    <field name="attestation_sent" readonly="1"/>
                    <field name="attestation_number" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
