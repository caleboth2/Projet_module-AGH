<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_certificate_form" model="ir.ui.view">
        <field name="name">hr.certificate.form</field>
        <field name="model">hr.certificate</field>
        <field name="arch" type="xml">
            <form string="Attestation">
                <header>
                    <button name="action_validate" string="Valider" type="object" 
                            class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_send_email" string="Envoyer par Email" type="object" 
                            class="btn-primary" invisible="state != 'validated'"/>
                    <button name="generate_pdf" string="Régénérer PDF" type="object" 
                            invisible="state == 'sent'"/>
                    <button name="action_view_pdf" string="Voir PDF" type="object" 
                            invisible="not pdf_attachment_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,validated,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Employé">
                            <field name="employee_id" readonly="state != 'requested'"/>
                            <field name="certificate_type" readonly="state != 'requested'"/>
                            <field name="date" readonly="state != 'requested'"/>
                        </group>
                        <group string="Signature &amp; Statut">
                            <field name="signature_name" readonly="state != 'requested'"/>
                            <field name="signature_image" widget="image" readonly="state != 'requested'"/>
                            <field name="email_sent" readonly="1"/>
                            <field name="send_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Dates Spécifiques" invisible="certificate_type != 'ATT_CONGE'">
                        <field name="leave_date_start" readonly="state != 'requested'"/>
                        <field name="leave_date_end" readonly="state != 'requested'"/>
                    </group>
                    <group string="Historique">
                        <field name="requested_by_id" readonly="1"/>
                        <field name="request_date" readonly="1"/>
                        <field name="pdf_attachment_id" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_certificate_tree" model="ir.ui.view">
        <field name="name">hr.certificate.list</field>
        <field name="model">hr.certificate</field>
        <field name="arch" type="xml">
            <list string="Attestations">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="certificate_type"/>
                <field name="date"/>
                <field name="requested_by_id"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'requested'" 
                       decoration-success="state == 'validated'" 
                       decoration-muted="state == 'sent'"/>
            </list>
        </field>
    </record>

    <record id="action_hr_certificate" model="ir.actions.act_window">
        <field name="name">Attestations</field>
        <field name="res_model">hr.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Gérez les attestations de vos employés.
            </p>
        </field>
    </record>

</odoo>
