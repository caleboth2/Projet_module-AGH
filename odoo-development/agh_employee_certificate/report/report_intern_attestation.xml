<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action rapport pour intern.profile -->
    <record id="action_report_attestation" model="ir.actions.report">
        <field name="name">Attestation Stagiaire</field>
        <field name="model">intern.profile</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agh_employee_certificate.report_attestation_document</field>
        <field name="report_file">agh_employee_certificate.report_attestation_document</field>
        <field name="binding_model_id" ref="model_intern_profile"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Attestation - %s' % (object.name)</field>
    </record>

    <!-- Template QWeb -->
    <template id="report_attestation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">

                    <div class="page"
                         style="font-family:Arial; font-size:16px; padding:35px 55px; line-height:1.6; color:#000;">

                        <!-- LOGO CENTRE -->
                        <div style="text-align:center; margin-bottom:15px;">
                            <img t-att-src="'/agh_employee_certificate/static/src/img/logo.png'"
                                 style="height:85px;"/>
                        </div>

                        <!-- NUMERO -->
                        <div style="text-align:right; margin-bottom:15px;">
                            <strong>N° : <t t-esc="doc.attestation_number"/></strong>
                        </div>

                        <!-- TITRE -->
                        <h2 style="text-align:center; font-size:30px; margin:10px 0 35px 0; font-weight:bold;">
                            ATTESTATION DE STAGE
                        </h2>

                        <!-- PARAGRAPHE 1 -->
                        <p style="text-align:justify; margin-bottom:18px;">
                            Je soussigné(e),
                            <strong><t t-esc="doc.supervisor"/></strong>,
                            <strong><t t-esc="doc.supervisor_job"/></strong>
                            de la société
                            <strong><t t-esc="doc.company_name"/></strong>,
                            certifie par la présente que :
                        </p>

                        <!-- PARAGRAPHE 2 -->
                        <p style="text-align:justify; margin-bottom:18px;">
                            <strong>M./Mme <t t-esc="doc.name"/></strong>,
                            titulaire de la carte d'identité nationale n°
                            <strong><t t-esc="doc.cine"/></strong>,
                            a effectué un stage au sein de notre établissement,
                            du <strong><t t-esc="doc.start_date"/></strong>
                            au <strong><t t-esc="doc.end_date"/></strong>.
                        </p>

                        <!-- PARAGRAPHE 3 -->
                        <p style="margin-bottom:35px;">
                            Nous délivrons la présente attestation
                            pour servir et valoir ce que de droit.
                        </p>

                        <!-- DATE -->
                        <p style="margin-bottom:45px;">
                            Fait à <strong><t t-esc="doc.city"/></strong>,
                            le <strong><t t-esc="doc.end_date"/></strong>.
                        </p>

                        <!-- SIGNATURE -->
                        <div style="text-align:right; margin-top:20px;">
                            <p style="margin-bottom:8px;">Signature et cachet</p>
                            <img t-att-src="'/agh_employee_certificate/static/src/img/signature.png'"
                                 style="height:85px;"/>
                            <br/>
                            <strong><t t-esc="doc.supervisor"/></strong>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>

</odoo>
