<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Séquence numéro attestation -->
        <record id="seq_attestation" model="ir.sequence">
            <field name="name">Attestation Sequence</field>
            <field name="code">intern.attestation</field>
            <field name="prefix">ATT/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- CRON : envoi automatique attestation employé en fin de contrat -->
        <record id="cron_auto_send_employee_attestation" model="ir.cron">
            <field name="name">AGH : Envoi auto attestation employé</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_send_attestation()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- CRON : envoi automatique attestation stagiaire (intern.profile) -->
        <record id="cron_send_intern_attestations" model="ir.cron">
            <field name="name">AGH : Envoi auto attestation stagiaire</field>
            <field name="model_id" ref="model_intern_profile"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_attestations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
