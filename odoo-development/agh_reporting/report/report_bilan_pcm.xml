<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_bilan_pcm" model="ir.actions.report">
        <field name="name">Bilan PCM</field>
        <field name="model">account.financial.report.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agh_reporting.report_bilan_pcm</field>
        <field name="report_file">agh_reporting.report_bilan_pcm</field>
        <field name="attachment_use">False</field>
    </record>

    <template id="report_bilan_pcm">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page" style="padding: 20px; font-family: Arial, sans-serif;">
                    <!-- En-tête -->
                    <div style="text-align: center; margin-bottom: 30px;">
                        <t t-if="docs.company_id.logo">
                            <img t-att-src="'data:image/png;base64,' + (docs.company_id.logo.decode('utf-8') if docs.company_id.logo else '')"
                                 style="max-height: 80px;" alt="Logo"/>
                        </t>
                        <h2>BILAN COMPTABLE</h2>
                        <h3>Arrêté au <t t-out="docs.date_to"/></h3>
                        <p><strong>Société:</strong> <t t-out="docs.company_id.name"/></p>
                    </div>

                    <!-- ACTIF -->
                    <h3 style="background-color: #e8f4fd; padding: 10px;">ACTIF</h3>
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                        <thead>
                            <tr style="background-color: #f0f0f0;">
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Rubrique</th>
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: right;">Montant (MAD)</th>
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: right;">N-1 (MAD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color: #f9f9f9;">
                                <td colspan="3" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">I. ACTIF IMMOBILISÉ</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Immobilisations incorporelles (21)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Immobilisations corporelles (22-23)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Immobilisations financières (25-26)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr style="background-color: #f9f9f9;">
                                <td colspan="3" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">II. ACTIF CIRCULANT</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Stocks (31-35)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Créances clients (342)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Autres créances (34-37)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Trésorerie actif (51-55)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr style="background-color: #e8f4fd;">
                                <td style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">TOTAL ACTIF</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">0,00</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- PASSIF -->
                    <h3 style="background-color: #e8f4fd; padding: 10px;">PASSIF</h3>
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #f0f0f0;">
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">Rubrique</th>
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: right;">Montant (MAD)</th>
                                <th style="border: 1px solid #ddd; padding: 8px; text-align: right;">N-1 (MAD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color: #f9f9f9;">
                                <td colspan="3" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">I. CAPITAUX PROPRES</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Capital social (111)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Réserves (112-115)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Report à nouveau (119)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Résultat de l'exercice</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr style="background-color: #f9f9f9;">
                                <td colspan="3" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">II. DETTES</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Dettes financières (16)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Dettes fournisseurs (441)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Dettes fiscales (444-445)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 8px; padding-left: 20px;">Dettes sociales (443)</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right;">0,00</td>
                            </tr>
                            <tr style="background-color: #e8f4fd;">
                                <td style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">TOTAL PASSIF</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 8px; text-align: right; font-weight: bold;">0,00</td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top: 50px; display: flex; justify-content: space-between;">
                        <div>
                            <p>Le comptable</p>
                            <div style="width: 150px; height: 60px; border: 1px solid #ccc;"></div>
                        </div>
                        <div>
                            <p>Le Directeur Général</p>
                            <div style="width: 150px; height: 60px; border: 1px solid #ccc;"></div>
                        </div>
                    </div>

                    <div style="margin-top: 20px; text-align: center; font-size: 10px; color: #666;">
                        Document généré électroniquement - Conforme au Plan Comptable Marocain (PCM)
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
