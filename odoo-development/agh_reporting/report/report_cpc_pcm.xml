<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cpc_pcm" model="ir.actions.report">
        <field name="name">CPC PCM</field>
        <field name="model">account.financial.report.print</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">agh_reporting.report_cpc_pcm</field>
        <field name="report_file">agh_reporting.report_cpc_pcm</field>
        <field name="attachment_use">False</field>
    </record>

    <template id="report_cpc_pcm">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page" style="padding: 20px; font-family: Arial, sans-serif;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <t t-if="docs.company_id.logo">
                            <img t-att-src="'data:image/png;base64,' + (docs.company_id.logo.decode('utf-8') if docs.company_id.logo else '')"
                                 style="max-height: 80px;" alt="Logo"/>
                        </t>
                        <h2>COMPTE DE PRODUITS ET CHARGES (CPC)</h2>
                        <h3>Du <t t-out="docs.date_from"/> au <t t-out="docs.date_to"/></h3>
                        <p><strong>Société:</strong> <t t-out="docs.company_id.name"/></p>
                    </div>

                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #f0f0f0;">
                                <th style="border: 1px solid #ddd; padding: 10px; text-align: left;">Rubrique</th>
                                <th style="border: 1px solid #ddd; padding: 10px; text-align: right;">Montant (MAD)</th>
                                <th style="border: 1px solid #ddd; padding: 10px; text-align: right;">N-1 (MAD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color: #e8f4fd;">
                                <td colspan="3" style="border: 1px solid #ddd; padding: 10px; font-weight: bold;">PRODUITS D'EXPLOITATION</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Ventes de biens et services (71-72)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Subventions (74)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Autres produits (75-78)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>

                            <tr style="background-color: #e8f4fd;">
                                <td colspan="3" style="border: 1px solid #ddd; padding: 10px; font-weight: bold;">CHARGES D'EXPLOITATION</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Achats vendus (61)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Autres achats et charges externes (62)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Charges de personnel (63)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Impôts et taxes (64)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Charges financières (65)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Dotations aux amortissements (68)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 10px; padding-left: 20px;">Autres charges (69)</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right;">0,00</td>
                            </tr>

                            <tr style="background-color: #d9edf7;">
                                <td style="border: 1px solid #ddd; padding: 10px; font-weight: bold;">RÉSULTAT NET DE L'EXERCICE</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right; font-weight: bold;">0,00</td>
                                <td style="border: 1px solid #ddd; padding: 10px; text-align: right; font-weight: bold;">0,00</td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top: 20px; text-align: center; font-size: 10px; color: #666;">
                        Document généré électroniquement - Conforme au Plan Comptable Marocain (PCM)
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
