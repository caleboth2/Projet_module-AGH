<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_category_tree" model="ir.ui.view">
        <field name="name">agh.knowledge.category.tree</field>
        <field name="model">agh.knowledge.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="article_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_category_form" model="ir.ui.view">
        <field name="name">agh.knowledge.category.form</field>
        <field name="model">agh.knowledge.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la catégorie..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id" placeholder="Catégorie parente"/>
                        <field name="color" widget="color"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_knowledge_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">agh.knowledge.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>