<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         Action export PDF
    ══════════════════════════════════════════════════════════════ -->
    <record id="action_export_pdf" model="ir.actions.report">
        <field name="name">Export PDF</field>
        <field name="type">ir.actions.report</field>
        <field name="model">agh.knowledge.article</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">knowledge_plus_final_v3.article_report</field>
        <field name="report_file">knowledge_plus_final_v3.article_report</field>
        <field name="print_report_name">'Article_' + object.name</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Vue KANBAN – Articles (méthode Agile)
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_knowledge_article_kanban" model="ir.ui.view">
        <field name="name">agh.knowledge.article.kanban</field>
        <field name="model">agh.knowledge.article</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="category_id"/>
                <field name="author_id"/>
                <field name="tag_ids"/>
                <field name="doc_priority"/>
                <field name="task_count"/>
                <field name="task_progress"/>
                <field name="view_count"/>
                <field name="ai_summary_date"/>
                <field name="version"/>
                <field name="color"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <!-- Bande couleur priorité -->
                        <aside>
                            <field name="doc_priority" widget="priority"/>
                        </aside>
                        <main>
                            <!-- Catégorie + Version -->
                            <div class="d-flex justify-content-between mb-1">
                                <span class="badge text-bg-secondary small"
                                      t-if="record.category_id.value"
                                      t-esc="record.category_id.value"/>
                                <span class="text-muted small">v<t t-esc="record.version.value"/></span>
                            </div>

                            <!-- Titre article -->
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>

                            <!-- Tags -->
                            <div class="mt-1" t-if="record.tag_ids.raw_value.length">
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color'}"/>
                            </div>

                            <!-- Progression tâches -->
                            <div class="mt-2" t-if="record.task_count.raw_value > 0">
                                <div class="d-flex justify-content-between text-muted small">
                                    <span>
                                        <i class="fa fa-tasks"/> <t t-esc="record.task_count.value"/> tâche(s)
                                    </span>
                                    <span>
                                        <t t-esc="record.task_progress.value"/>%
                                    </span>
                                </div>
                                <div class="progress mt-1" style="height:4px">
                                    <div class="progress-bar"
                                         t-attf-style="width: #{record.task_progress.raw_value}%"/>
                                </div>
                            </div>

                            <!-- Pied de carte -->
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="author_id" widget="many2one_avatar_user"/>
                                <div class="text-muted small">
                                    <span t-if="record.ai_summary_date.raw_value">
                                        <i class="fa fa-magic text-primary"/> IA
                                    </span>
                                    <span class="ms-2">
                                        <i class="fa fa-eye"/> <t t-esc="record.view_count.value"/>
                                    </span>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Vue LISTE – Articles
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_knowledge_article_tree" model="ir.ui.view">
        <field name="name">agh.knowledge.article.list</field>
        <field name="model">agh.knowledge.article</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'archived'"
                  decoration-success="state == 'approved'"
                  decoration-warning="state == 'pending'">
                <field name="name"/>
                <field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('draft', 'archived')"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="doc_priority" widget="priority"/>
                <field name="task_count" string="Tâches"/>
                <field name="view_count" string="Vues"/>
                <field name="version"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Vue FORMULAIRE – Article (onglets simplifiés)
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_knowledge_article_form" model="ir.ui.view">
        <field name="name">agh.knowledge.article.form</field>
        <field name="model">agh.knowledge.article</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Soumettre" type="object"
                            invisible="state not in ['draft']" class="btn-primary"/>
                    <button name="action_approve" string="Approuver" type="object"
                            invisible="state not in ['pending']" class="btn-success"/>
                    <button name="action_reject" string="Rejeter" type="object"
                            invisible="state not in ['pending']" class="btn-danger"/>
                    <button name="action_reset_draft" string="Remettre en brouillon"
                            type="object" invisible="state not in ['pending', 'rejected']"
                            class="btn-secondary"/>
                    <button name="action_archive_with_reason" string="Archiver" type="object"
                            invisible="state not in ['draft', 'approved']" class="btn-warning"/>
                    <button name="action_restore_from_archive" string="Restaurer" type="object"
                            invisible="state not in ['archived']" class="btn-success"/>
                    <button name="action_permanent_delete" string="Supprimer définitivement"
                            type="object" invisible="state not in ['archived']" class="btn-danger"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved,archived"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <div class="o_stat_info">
                                <field name="view_count" class="o_stat_value"/>
                                <span class="o_stat_text">Consultations</span>
                            </div>
                        </button>
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <div class="o_stat_info">
                                <field name="document_count" class="o_stat_value"/>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                        <button name="action_open_chat" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info">
                                <field name="message_count" class="o_stat_value"/>
                                <span class="o_stat_text">Chat</span>
                            </div>
                        </button>
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks"
                                invisible="task_count == 0">
                            <div class="o_stat_info">
                                <field name="task_count" class="o_stat_value"/>
                                <span class="o_stat_text">Tâches</span>
                            </div>
                        </button>
                        <button name="action_view_project" type="object"
                                class="oe_stat_button" icon="fa-folder-open"
                                invisible="project_count == 0">
                            <div class="o_stat_info">
                                <field name="project_count" class="o_stat_value"/>
                                <span class="o_stat_text">Projet</span>
                            </div>
                        </button>
                        <button name="action_view_ba_specs" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="ba_spec_count == 0">
                            <div class="o_stat_info">
                                <field name="ba_spec_count" class="o_stat_value"/>
                                <span class="o_stat_text">CDC</span>
                            </div>
                        </button>
                        <button name="action_generate_ai_summary" type="object"
                                class="oe_stat_button" icon="fa-magic"
                                invisible="not content">
                            <div class="o_stat_info">
                                <span class="o_stat_value">IA</span>
                                <span class="o_stat_text">Résumer</span>
                            </div>
                        </button>
                    </div>

                    <!-- Titre -->
                    <div class="oe_title">
                        <label for="name" string="Titre"/>
                        <h1>
                            <field name="name" placeholder="Titre de l'article..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Générales">
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="author_id"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Suivi &amp; Documents" name="tracking_group">
                            <field name="doc_priority" widget="priority"/>
                            <field name="task_progress" widget="progressbar"/>
                            <field name="version"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ── Contenu ── -->
                        <page string="Contenu" name="content_page">
                            <field name="content" widget="html"/>
                        </page>

                        <!-- ── Validation ── -->
                        <page string="Validation" name="validation_page">
                            <group>
                                <group string="Validation &amp; Approbateurs">
                                    <field name="validation_comment"
                                           placeholder="Commentaire de validation..."/>
                                    <field name="rejection_reason"
                                           placeholder="Motif du rejet..."/>
                                    <field name="approved_by" readonly="1"
                                           invisible="state != 'approved'"/>
                                    <field name="approval_date" readonly="1"
                                           invisible="state != 'approved'"/>
                                </group>
                                <group string="Spécifications (Cahiers des charges)">
                                    <field name="ba_spec_ids" widget="many2many_tags"
                                           domain="[('state', '!=', 'obsolete')]"
                                           placeholder="Lier des cahiers des charges..."/>
                                    <field name="project_note" placeholder="Notes internes liées au projet..."/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Statistiques ── -->
                        <page string="Statistiques" name="stats_page">
                            <group>
                                <group string="Consultations">
                                    <field name="view_count"/>
                                    <field name="last_view_date"/>
                                    <field name="last_view_by"/>
                                    <field name="favorite_count"/>
                                </group>
                                <group string="Métadonnées">
                                    <field name="published_date"/>
                                    <field name="retention_days"/>
                                    <field name="auto_archive_date"/>
                                </group>
                            </group>
                        </page>

                        <!-- ── Archivage ── -->
                        <page string="Archivage" name="archive_page"
                               invisible="state != 'archived'">
                            <group>
                                <field name="archive_reason"/>
                                <field name="archived_by"/>
                                <field name="archive_date"/>
                            </group>
                        </page>

                        <!-- ══ ONGLET IA ══════════════════════════════════════════ -->
                        <page string="Assistant IA" name="ai_page">
                            <!-- Barre d'actions IA -->
                            <div class="o_field_widget mb-3">
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <button name="action_generate_ai_summary"
                                            string="Résumé rapide"
                                            type="object" class="btn btn-primary btn-sm"
                                            icon="fa-magic"/>
                                    <button name="action_update_embedding"
                                            string="Indexer pour le RAG"
                                            type="object" class="btn btn-info btn-sm"
                                            icon="fa-search-plus"
                                            help="Génère un vecteur d'embedding pour permettre la recherche intelligente."/>
                                    <button name="action_open_meeting_notes_wizard"
                                            string="Synthèse réunion"
                                            type="object" class="btn btn-secondary btn-sm"
                                            icon="fa-file-text-o"/>
                                    <button name="action_open_template_wizard"
                                            string="Template BA"
                                            type="object" class="btn btn-secondary btn-sm"
                                            icon="fa-wpforms"/>
                                    <button name="action_open_suggest_wizard"
                                            string="Analyse contenu"
                                            type="object" class="btn btn-warning btn-sm"
                                            icon="fa-lightbulb-o"/>
                                </div>
                            </div>
                            <!-- Template utilisé -->
                            <group string="Configuration &amp; Indexation RAG">
                                <group>
                                    <field name="ai_template_type"/>
                                    <field name="ai_summary_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_embedding_update" readonly="1" string="Dernière indexation"/>
                                    <span class="text-muted small" invisible="not last_embedding_update">
                                        L'article est prêt pour la recherche sémantique.
                                    </span>
                                </group>
                            </group>
                            <!-- Résumé IA -->
                            <group string="Résumé automatique IA">
                                <field name="ai_summary" widget="html" nolabel="1"
                                       placeholder="Cliquez sur 'Résumé rapide' pour créer un résumé automatique."/>
                            </group>
                            <!-- Suggestions -->
                            <group string="Suggestions IA – Contenu manquant"
                                   invisible="not ai_suggestions">
                                <field name="ai_suggestions" widget="html" nolabel="1"/>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                <strong>Souveraineté IA :</strong>
                                Cet assistant fonctionne <strong>localement</strong> via Ollama (Llama 3.2 1B &amp; Nomic-Embed).
                                Aucune donnée ne quitte votre serveur.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Vue RECHERCHE
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_knowledge_article_search" model="ir.ui.view">
        <field name="name">agh.knowledge.article.search</field>
        <field name="model">agh.knowledge.article</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Titre" filter_domain="[('name', 'ilike', self)]"/>
                <field name="content" string="Contenu" filter_domain="[('content', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <field name="author_id"/>
                <!-- Filtres rapides -->
                <filter name="filter_draft"    string="Brouillons"  domain="[('state','=','draft')]"/>
                <filter name="filter_pending"  string="En attente"  domain="[('state','=','pending')]"/>
                <filter name="filter_approved" string="Approuvés"   domain="[('state','=','approved')]"/>
                <filter name="filter_mine"     string="Mes articles" domain="[('author_id','=',uid)]"/>
                <filter name="filter_ai"       string="Avec résumé IA"
                        domain="[('ai_summary_date','!=',False)]"/>
                <separator/>
                <group expand="0" string="Grouper par">
                    <filter name="group_category" string="Catégorie"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_state"    string="Statut"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_author"   string="Auteur"
                            context="{'group_by': 'author_id'}"/>
                    <filter name="group_priority" string="Priorité"
                            context="{'group_by': 'doc_priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue articles archivés -->
    <record id="view_knowledge_article_archived_tree" model="ir.ui.view">
        <field name="name">agh.knowledge.article.archived.list</field>
        <field name="model">agh.knowledge.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="archive_reason"/>
                <field name="archived_by"/>
                <field name="archive_date"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Actions
    ══════════════════════════════════════════════════════════════ -->
    <record id="action_knowledge_article" model="ir.actions.act_window">
        <field name="name">Articles de connaissance</field>
        <field name="res_model">agh.knowledge.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_approved': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier article de connaissance
            </p>
            <p>Centralisez toute la connaissance de l'App Factory : études de marché,
               personas, user stories, décisions stratégiques et post-mortem.</p>
        </field>
    </record>

    <record id="action_knowledge_article_archived" model="ir.actions.act_window">
        <field name="name">Articles archivés</field>
        <field name="res_model">agh.knowledge.article</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', False)]</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="action_knowledge_article_kanban" model="ir.actions.act_window">
        <field name="name">Kanban – Articles Agile</field>
        <field name="res_model">agh.knowledge.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'group_by': 'state'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun article en cours
            </p>
            <p>Gérez vos articles en mode Kanban selon la méthode Agile.</p>
        </field>
    </record>

</odoo>
