<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_knowledge_workflow_config_tree" model="ir.ui.view">
        <field name="name">agh.knowledge.workflow.config.tree</field>
        <field name="model">agh.knowledge.workflow.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="requires_validation"/>
                <field name="auto_approve"/>
            </list>
        </field>
    </record>

    <record id="view_knowledge_workflow_config_form" model="ir.ui.view">
        <field name="name">agh.knowledge.workflow.config.form</field>
        <field name="model">agh.knowledge.workflow.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la configuration..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="category_id"/>
                        <field name="approver_ids" widget="many2many_tags"/>
                        <field name="requires_validation"/>
                        <field name="auto_approve"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_knowledge_workflow_config" model="ir.actions.act_window">
        <field name="name">Configuration Workflow</field>
        <field name="res_model">agh.knowledge.workflow.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
