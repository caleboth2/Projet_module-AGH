            <field name="pcm_journal_type">achat</field>
            <field name="sequence_prefix_pcm">ACH</field>
            <field name="show_on_dashboard" eval="True"/>
        </record>

        <!-- Journal de Banque (BQ) -->
        <record id="pcm_journal_bank" model="account.journal">
            <field name="name">Journal de Banque (PCM)</field>
            <field name="code">BQ</field>
            <field name="type">bank</field>
            <field name="pcm_journal_type">banque</field>
            <field name="sequence_prefix_pcm">BQ</field>
            <field name="show_on_dashboard" eval="True"/>
        </record>

        <!-- Journal de Caisse (CAI) -->
        <record id="pcm_journal_cash" model="account.journal">
            <field name="name">Journal de Caisse (PCM)</field>
            <field name="code">CAI</field>
            <field name="type">cash</field>
            <field name="pcm_journal_type">caisse</field>
            <field name="sequence_prefix_pcm">CAI</field>
