<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Journal des Ventes (VTE) -->
        <record id="pcm_journal_sale" model="account.journal">
            <field name="name">Journal des Ventes (PCM)</field>
            <field name="code">VTE</field>
            <field name="type">sale</field>
            <field name="pcm_journal_type">vente</field>
            <field name="sequence_prefix_pcm">VTE</field>
            <field name="show_on_dashboard" eval="True"/>
        </record>

        <!-- Journal des Achats (ACH) -->
        <record id="pcm_journal_purchase" model="account.journal">
            <field name="name">Journal des Achats (PCM)</field>
            <field name="code">ACH</field>
