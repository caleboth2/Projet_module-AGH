        </record>

        <!-- Journal des Opérations Diverses (OD) -->
        <record id="pcm_journal_general" model="account.journal">
            <field name="name">Opérations Diverses (PCM)</field>
            <field name="code">OD</field>
            <field name="type">general</field>
            <field name="pcm_journal_type">od</field>
            <field name="sequence_prefix_pcm">OD</field>
            <field name="show_on_dashboard" eval="True"/>
        </record>
    </data>
</odoo>
