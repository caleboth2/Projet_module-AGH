<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu Racine Comptabilité (Visible en Community) -->
    <menuitem id="menu_finance_root"
              name="Comptabilité"
              web_icon="account,static/description/icon.png"
              groups="account.group_account_user,account.group_account_manager,account.group_account_invoice"
              sequence="40"/>

    <!-- Menu Client -->
    <menuitem id="menu_finance_receivable"
              name="Clients"
              parent="menu_finance_root"
              sequence="1"/>

    <menuitem id="menu_action_move_out_invoice_type"
              name="Factures Clients"
              parent="menu_finance_receivable"
              action="account.action_move_out_invoice_type"
              sequence="10"/>

    <menuitem id="menu_action_move_out_refund_type"
              name="Avoirs Clients"
              parent="menu_finance_receivable"
              action="account.action_move_out_refund_type"
              sequence="20"/>

    <menuitem id="menu_action_account_payments_receivable"
              name="Paiements"
              parent="menu_finance_receivable"
              action="account.action_account_payments"
              sequence="30"/>

    <!-- Menu Fournisseur -->
    <menuitem id="menu_finance_payable"
              name="Fournisseurs"
              parent="menu_finance_root"
              sequence="2"/>

    <menuitem id="menu_action_move_in_invoice_type"
              name="Factures Fournisseurs"
              parent="menu_finance_payable"
              action="account.action_move_in_invoice_type"
              sequence="10"/>

    <menuitem id="menu_action_move_in_refund_type"
              name="Avoirs Fournisseurs"
              parent="menu_finance_payable"
              action="account.action_move_in_refund_type"
              sequence="20"/>

    <menuitem id="menu_action_account_payments_payable"
              name="Paiements"
              parent="menu_finance_payable"
              action="account.action_account_payments_payable"
              sequence="30"/>

    <!-- Menu Comptabilité (Ecritures, Journaux, etc) -->
    <menuitem id="menu_finance_entries"
              name="Comptabilité"
              parent="menu_finance_root"
              sequence="3"/>

    <menuitem id="menu_action_move_journal_line"
              name="Pièces Comptables"
              parent="menu_finance_entries"
              action="account.action_move_journal_line"
              sequence="10"/>

    <menuitem id="menu_action_account_moves_all"
              name="Écritures Comptables"
              parent="menu_finance_entries"
              action="account.action_account_moves_all"
              sequence="20"/>

    <menuitem id="menu_action_account_fiscal_year"
              name="Exercices"
              parent="menu_finance_entries"
              action="agh_accounting_core.action_fiscal_year"
              sequence="30"/>

    <!-- Menu Configuration (Relier les menus existants) -->
    <menuitem id="menu_finance_configuration_root"
              name="Configuration"
              parent="menu_finance_root"
              sequence="100"/>

    <menuitem id="menu_action_account_form"
              name="Plan Comptable"
              parent="menu_finance_configuration_root"
              action="account.action_account_form"
              sequence="10"/>

    <menuitem id="menu_action_account_journal_form"
              name="Journaux"
              parent="menu_finance_configuration_root"
              action="account.action_account_journal_form"
              sequence="20"/>

    <menuitem id="menu_action_tax_form"
              name="Taxes"
              parent="menu_finance_configuration_root"
              action="account.action_tax_form"
              sequence="30"/>

</odoo>
