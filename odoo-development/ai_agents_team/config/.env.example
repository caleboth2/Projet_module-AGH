# ═══════════════════════════════════════════════════════════════════
# AI Agents Team — Configuration d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════

# ── Odoo ──────────────────────────────────────────────────────────
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin@company.com
ODOO_PASSWORD=changeme
ODOO_PROJECT_ID=1                     # ID du projet Odoo principal

# ── LLM Local (Ollama sur GPU dédié) ──────────────────────────────
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=mistral:7b-instruct   # ou llama3:8b, codestral:22b

# ── Anthropic Claude (fallback cloud) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── GitHub ────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=AGH-Data-Agency-Holding/odoo-development
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── Android / QA Agent ────────────────────────────────────────────
ADB_PATH=/usr/local/bin/adb
ANDROID_DEVICE=emulator-5554
ANDROID_PACKAGE=com.agh.app
MONKEY_EVENTS=500
MONKEY_SEED=42

# ── Redis (queue inter-agents) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_PERSIST_PATH=/data/chromadb

# ── Serveur Webhook ───────────────────────────────────────────────
WEBHOOK_PORT=8080

# ── Team Matrix (optionnel — override JSON) ───────────────────────
# TEAM_MATRIX=[{"github":"dev-backend","skills":["odoo","python"],"odoo_user_id":3}]
