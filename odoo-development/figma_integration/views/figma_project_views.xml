<odoo>

    <!-- LIST -->
    <record id="view_figma_project_list" model="ir.ui.view">

        <field name="name">agh.figma.project.list</field>

        <field name="model">agh.figma.project</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>
                <field name="project_id"/>
                <field name="team_id"/>

            </list>

        </field>

    </record>

    <!-- FORM -->
    <record id="view_figma_project_form" model="ir.ui.view">

        <field name="name">agh.figma.project.form</field>

        <field name="model">agh.figma.project</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_sync_files"
                        type="object"
                        string="Sync Designs"
                        class="btn-primary"/>

                </header>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="team_id"/>

                    </group>

                    <notebook>

                        <page string="Designs">

                            <field name="design_ids">

                                <list>

                                    <field name="name"/>
                                    <field name="figma_file_key"/>
                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>

    <!-- ACTION -->
    <record id="action_figma_projects" model="ir.actions.act_window">

        <field name="name">Projects</field>

        <field name="res_model">agh.figma.project</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>