<odoo>

    <!-- LIST -->
    <record id="view_figma_team_list" model="ir.ui.view">
        <field name="name">agh.figma.team.list</field>
        <field name="model">agh.figma.team</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_figma_team_form" model="ir.ui.view">
        <field name="name">agh.figma.team.form</field>
        <field name="model">agh.figma.team</field>

        <field name="arch" type="xml">
            <form>

                <header>

                    <button
                        name="action_sync_projects"
                        type="object"
                        string="Sync Projects"
                        class="btn-primary"/>

                    <button
                         name="action_sync_all"
                         type="object"
                         string="Sync All"
                         class="btn-secondary"/>

                </header>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="team_id"/>

                    </group>

                    <notebook>

                        <page string="Projects">

                            <field name="project_ids">

                                <list>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_figma_teams" model="ir.actions.act_window">

        <field name="name">Teams</field>

        <field name="res_model">agh.figma.team</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>