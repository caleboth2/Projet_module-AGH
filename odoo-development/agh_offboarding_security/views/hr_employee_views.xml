<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_offboarding"
            model="ir.ui.view">

        <field name="name">hr.employee.form.offboarding</field>
        <field name="model">hr.employee</field>

        <field name="inherit_id"
               ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">

                <button name="action_start_offboarding"
                        type="object"
                        string="Start Offboarding"
                        class="btn-danger"/>

            </xpath>

        </field>

    </record>

</odoo>