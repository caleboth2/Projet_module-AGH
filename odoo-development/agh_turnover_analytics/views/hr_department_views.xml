<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_department_form_turnover"
            model="ir.ui.view">

        <field name="name">hr.department.form.turnover</field>

        <field name="model">hr.department</field>

        <field name="inherit_id"
               ref="hr.view_department_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/group"
                   position="inside">

                <group string="Turnover Analytics">

                    <field name="employee_count"
                           readonly="1"/>

                    <field name="departure_count"
                           readonly="1"/>

                    <field name="turnover_rate"
                           readonly="1"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>