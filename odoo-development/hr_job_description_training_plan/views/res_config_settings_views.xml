<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_hr_job" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.job.training</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- On ajoute notre bloc dans les paramètres de l'application "Employés" (hr) -->
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Stages et Fiches de Poste" name="internship_training_setting">
                    <setting string="Durée par défaut des stages" help="S'appliquera automatiquement aux nouveaux postes de type stage.">
                        <field name="job_default_internship_duration"/>
                    </setting>
                    <setting string="Horaires par défaut" help="S'appliquera automatiquement aux nouveaux postes de type stage.">
                        <field name="job_default_work_schedule"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>