<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_agh_gumroad_daily_sync" model="ir.cron">
            <field name="name">AGH Gumroad: Daily Sales Sync</field>
            <field name="model_id" ref="model_agh_gumroad_connector"/>
            <field name="state">code</field>
            <field name="code">model.cron_daily_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_agh_gumroad_weekly_report" model="ir.cron">
            <field name="name">AGH Gumroad: Weekly AI Report (Ollama local)</field>
            <field name="model_id" ref="model_agh_gumroad_report"/>
            <field name="state">code</field>
            <field name="code">model.cron_weekly_report()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
