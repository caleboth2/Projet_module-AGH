<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agh_gumroad_sync_wizard_form" model="ir.ui.view">
        <field name="name">agh.gumroad.sync.wizard.form</field>
        <field name="model">agh.gumroad.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Sync">
                <group>
                    <field name="connector_id"/>
                    <field name="days"/>
                    <field name="sync_products"/>
                </group>
                <footer>
                    <button name="action_run" string="Run Sync" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_agh_gumroad_sync_wizard" model="ir.actions.act_window">
        <field name="name">Manual Sync</field>
        <field name="res_model">agh.gumroad.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
