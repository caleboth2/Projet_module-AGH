<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agh_gumroad_sale_list" model="ir.ui.view">
        <field name="name">agh.gumroad.sale.list</field>
        <field name="model">agh.gumroad.sale</field>
        <field name="arch" type="xml">
            <list string="Sales">
                <field name="sale_date"/>
                <field name="product_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="quantity"/>
                <field name="total_price"/>
                <field name="currency"/>
                <field name="country"/>
                <field name="referrer"/>
                <field name="refunded"/>
            </list>
        </field>
    </record>

    <record id="view_agh_gumroad_sale_form" model="ir.ui.view">
        <field name="name">agh.gumroad.sale.form</field>
        <field name="model">agh.gumroad.sale</field>
        <field name="arch" type="xml">
            <form string="Gumroad Sale">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="sale_date"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="quantity"/>
                            <field name="total_price"/>
                            <field name="currency"/>
                            <field name="country"/>
                            <field name="referrer"/>
                            <field name="refunded"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Gumroad Payload (audit)">
                            <field name="raw_json" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agh_gumroad_sale_search" model="ir.ui.view">
        <field name="name">agh.gumroad.sale.search</field>
        <field name="model">agh.gumroad.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="referrer"/>
                <field name="country"/>
                <filter name="not_refunded" string="Not Refunded" domain="[('refunded','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_referrer" string="Source" context="{'group_by':'referrer'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_agh_gumroad_sale" model="ir.actions.act_window">
        <field name="name">AGH Gumroad Sales</field>
        <field name="res_model">agh.gumroad.sale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
