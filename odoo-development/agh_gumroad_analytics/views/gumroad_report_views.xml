<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agh_gumroad_report_list" model="ir.ui.view">
        <field name="name">agh.gumroad.report.list</field>
        <field name="model">agh.gumroad.report</field>
        <field name="arch" type="xml">
            <list string="Weekly Reports">
                <field name="date"/>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_revenue"/>
                <field name="total_sales"/>
                <field name="growth_rate"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_agh_gumroad_report_form" model="ir.ui.view">
        <field name="name">agh.gumroad.report.form</field>
        <field name="model">agh.gumroad.report</field>
        <field name="arch" type="xml">
            <form string="AGH Gumroad Report">
                <header>
                    <button name="action_generate" string="Generate AI Report (Ollama local)"
                            type="object" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_publish_to_knowledge" string="Publish to Knowledge"
                            type="object" class="btn-secondary"
                            invisible="state != 'generated'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="total_revenue"/>
                            <field name="total_sales"/>
                            <field name="growth_rate"/>
                            <field name="knowledge_article_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report"><field name="content_html" widget="html"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_agh_gumroad_report" model="ir.actions.act_window">
        <field name="name">Weekly Reports</field>
        <field name="res_model">agh.gumroad.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
