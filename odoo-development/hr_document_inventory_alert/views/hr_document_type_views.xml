<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_document_type_list" model="ir.ui.view">
        <field name="name">hr.document.type.list</field>
        <field name="model">hr.document.type</field>
        <field name="arch" type="xml">
            <list string="Types de documents">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hr_document_type_form" model="ir.ui.view">
        <field name="name">hr.document.type.form</field>
        <field name="model">hr.document.type</field>
        <field name="arch" type="xml">
            <form string="Type de document">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_document_type" model="ir.actions.act_window">
        <field name="name">Types de documents</field>
        <field name="res_model">hr.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_hr_document_inventory_root"
        name="Inventaire Documents"
        sequence="60"
    />

    <menuitem
        id="menu_hr_document_type"
        name="Types de documents"
        parent="menu_hr_document_inventory_root"
        action="action_hr_document_type"
        sequence="10"
    />

</odoo>